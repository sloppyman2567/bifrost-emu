#!/usr/bin/make -f
# Packaging for bifrost-emu: the project's own Makefile builds ./bifrost-emu; the test suite needs
# AArch64 guest toolchains that are downloaded on demand, so it is not run at package build time.
# No LTO: the project's JIT and its helpers are not built or tested with it.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto

# The Makefile only supplies its own flags (-ISource, -std=c++17, -O3, ...) when CXXFLAGS is unset, and
# the package build environment sets it, so pass the hardening flags and then the project's.
export CXXFLAGS := $(shell dpkg-buildflags --get CPPFLAGS) $(shell dpkg-buildflags --get CXXFLAGS) \
    -O3 -std=c++17 -pthread -Wall -Wextra -IInclude -ISource -MMD -MP

SETUP := debian/bifrost-emu/usr/share/bifrost/setup

%:
	dh $@

override_dh_auto_build:
	$(MAKE) all

override_dh_auto_test:

# Tests/Apps/toybox is an AArch64 guest program (the rootfs shell): not for the host's strip or ldd.
override_dh_strip:
	dh_strip --no-automatic-dbgsym -Xtoybox

override_dh_shlibdeps:
	dh_shlibdeps -Xtoybox

override_dh_dwz:
	dh_dwz -Xtoybox

override_dh_auto_clean:
	$(MAKE) clean

override_dh_auto_install:
	install -D -m 0755 bifrost-emu debian/bifrost-emu/usr/bin/bifrost-emu
	# The scripts "bifrost-emu --setup-rootfs" runs; it copies this tree to a per-user cache first,
	# because they download and build next to themselves.
	install -d $(SETUP)/Scripts/Setup $(SETUP)/Tools/Fetch $(SETUP)/Tests/Apps
	install -m 0755 Scripts/Setup/*.sh Scripts/Setup/*.py $(SETUP)/Scripts/Setup/
	install -m 0755 Tools/Fetch/fetch-glibc-toolchain.sh Tools/Fetch/fetch-musl-toolchain.sh $(SETUP)/Tools/Fetch/
	install -m 0755 Tests/Apps/toybox $(SETUP)/Tests/Apps/toybox
	# bifrost-emu-asgard: what "asgard-setup" needs to provision and install Asgard (see Scripts/Setup/install-asgard.py).
	install -D -m 0755 debian/asgard-setup debian/bifrost-emu-asgard/usr/bin/asgard-setup
	for d in Scripts/Android Tools/Android Tools/CodeGen Guest/Android Include ThirdParty/GLRegistry; do \
	    mkdir -p debian/bifrost-emu-asgard/usr/share/bifrost/setup/$$d; \
	    cp -a $$d/. debian/bifrost-emu-asgard/usr/share/bifrost/setup/$$d/; \
	done
	find debian/bifrost-emu-asgard/usr/share/bifrost/setup \( -name __pycache__ -o -name '*.pyc' -o -name 'test_*' -o -name 'run_*.sh' \) -prune -exec rm -rf {} +
	# Source files keep an executable bit in the repository; only scripts (a "#!" first line) should have one.
	find debian/bifrost-emu-asgard/usr/share/bifrost/setup -type f -exec sh -c 'head -c2 "$$1" | grep -q "#!" || chmod 0644 "$$1"' _ {} \;
	install -D -m 0644 Source/System/Audio/AudioThunk/AudioThunk.cpp \
	    debian/bifrost-emu-asgard/usr/share/bifrost/setup/Source/System/Audio/AudioThunk/AudioThunk.cpp
	install -D -m 0644 Tests/Unit/android_bionic_start.S debian/bifrost-emu-asgard/usr/share/bifrost/setup/Tests/Unit/android_bionic_start.S
	install -D -m 0644 Tests/Unit/android_jni/Bootstrap.java debian/bifrost-emu-asgard/usr/share/bifrost/setup/Tests/Unit/android_jni/Bootstrap.java
	install -D -m 0644 Tests/Unit/android_jni/bridge.c debian/bifrost-emu-asgard/usr/share/bifrost/setup/Tests/Unit/android_jni/bridge.c
	# (install-asgard.py itself is in bifrost-emu's Scripts/Setup, which this package depends on.)

override_dh_installexamples:
	dh_installexamples bifrost.toml.sample
	chmod 0644 debian/bifrost-emu/usr/share/doc/bifrost-emu/examples/bifrost.toml.sample

override_dh_installchangelogs:
	dh_installchangelogs Docs/CHANGELOG.md
